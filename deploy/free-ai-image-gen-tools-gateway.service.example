# systemd service example (cloud server always-on + auto-start on boot)
# Copy to /etc/systemd/system/free-ai-image-gen-tools-gateway.service, change WorkingDirectory/User, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now free-ai-image-gen-tools-gateway
#   journalctl -u free-ai-image-gen-tools-gateway -f
[Unit]
Description=Unified AI Image Gateway
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/free-ai-image-gen-tools-gateway
# For cloud, it's recommended to put credentials/secrets in environment variables, not in config.yaml
Environment=ADMIN_TOKEN=change-me
Environment=STORAGE_DIR=/data/imgw
ExecStart=/usr/bin/python3 -m imggen.server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
