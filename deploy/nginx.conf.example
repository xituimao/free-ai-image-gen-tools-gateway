# Nginx reverse proxy example (cloud server, HTTPS domain for external access)
# Place to /etc/nginx/conf.d/imgw.conf, change server_name and certificate path, then: nginx -t && nginx -s reload
server {
    listen 80;
    server_name img.yourdomain.com;
    # Suggest applying certificate with certbot and switch to 443 + 301 redirect
    client_max_body_size 12m;   # Match upload limit

    location / {
        proxy_pass http://127.0.0.1:8799;
        proxy_http_version 1.1;

        # Key: pass real protocol/host to gateway so it can build correct absolute image URLs
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        # SSE (HF queue/event stream, MCP Streamable HTTP) requires disabling buffering and keeping long connections open
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    # MCP endpoint /mcp goes through same reverse proxy (SSE config above covers it);
    # for separate rate limiting or auth, write a separate location /mcp {} block here.
}
